<Window x:Class="DoctorARM.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DoctorARM.Gui.ViewModels"
        xmlns:local="clr-namespace:DoctorARM.Gui"
        Title="DoctorARM - ARM Diagnostic Tool" 
        Height="720" 
        Width="920"
        Background="#F8F9FA"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <local:PassedToIconConverter x:Key="PassedToIconConverter"/>
        <local:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="20" Height="90">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🔍 DoctorARM" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Modular Diagnostic &amp; Auto-Fix Suite for Active Risk Manager" FontSize="12" Foreground="#BDC3C7"/>
                        <TextBlock Text="{Binding ComputerName, StringFormat='  •  Machine: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#4DABF7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Unified Professional Bottom Status Bar -->
            <Border DockPanel.Dock="Bottom" 
                    Background="#1E2B37" 
                    Padding="15,8" 
                    Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏳ " 
                                   FontSize="12" 
                                   Foreground="#FFC107"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding StatusMessage}" 
                                   FontSize="12" 
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ComputerName, StringFormat='💻 Machine: {0}'}" 
                               FontSize="12" 
                               Foreground="#A0AEC0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Main Content Scroll Area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- Status Card -->
                    <Border Background="White" BorderBrush="#E9ECEF" BorderThickness="1" Padding="20" CornerRadius="6" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Diagnostic Suite Overview" FontSize="16" FontWeight="Bold" Foreground="#343A40" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Overall Result -->
                                <StackPanel>
                                    <TextBlock Text="Overall Result:" FontSize="12" Foreground="#6C757D"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CurrentResult.Status}" 
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding CurrentResult.Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentResult.Timestamp, StringFormat=' ({0:HH:mm:ss})'}" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="#868E96"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Run Diagnostics" 
                                            Command="{Binding RunDiagnosticsCommand}"
                                            Background="#0D6EFD"
                                            Foreground="White"
                                            Padding="16,10"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Margin="0,0,10,0"/>

                                    <Button Content="Fix Issues" 
                                            Command="{Binding FixPermissionsCommand}"
                                            Background="#198754"
                                            Foreground="White"
                                            Padding="16,10"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostic Checks Section -->
                    <TextBlock Text="Registered Diagnostic Checks" FontSize="16" FontWeight="Bold" Foreground="#343A40" Margin="0,0,0,15"/>

                    <ItemsControl ItemsSource="{Binding CheckResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15" Margin="0,0,0,12" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFF5F5"/>
                                            <Setter Property="BorderBrush" Value="#DC3545"/>
                                            <Setter Property="BorderThickness" Value="0,0,4,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                    <Setter Property="Background" Value="#F8F9FA"/>
                                                    <Setter Property="BorderBrush" Value="#198754"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <!-- Category Tag, Check Name and Passed/Failed Icon -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#E9ECEF" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Category}" 
                                                               FontSize="10" 
                                                               FontWeight="Bold" 
                                                               Foreground="#495057"/>
                                                </Border>

                                                <TextBlock Text="{Binding CheckName}" 
                                                           FontSize="14" 
                                                           FontWeight="Bold"
                                                           Foreground="#212529"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Passed, Converter={StaticResource PassedToIconConverter}}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Passed, Converter={StaticResource StatusToBrushConverter}}"/>
                                        </Grid>

                                        <!-- Message -->
                                        <TextBlock Text="{Binding Message}" 
                                                   FontSize="12" 
                                                   Foreground="#495057"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>

                                        <!-- Permissions details if present -->
                                        <ItemsControl ItemsSource="{Binding Permissions}" 
                                                       Visibility="{Binding Permissions.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='• Permission: {0}'}" 
                                                               FontSize="11" 
                                                               Foreground="#6C757D"
                                                               Margin="0,2,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Errors Section -->
                    <Border Background="White" 
                            BorderBrush="#F8D7DA" 
                            BorderThickness="1" 
                            Padding="15" 
                            CornerRadius="4"
                            Visibility="{Binding CurrentResult.Errors.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Errors" FontSize="14" FontWeight="Bold" Foreground="#DC3545" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding CurrentResult.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                   FontSize="11" 
                                                   Foreground="#842029"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
